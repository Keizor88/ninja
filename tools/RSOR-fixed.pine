//@version=6
indicator("RSOR v2 (fixed) - Regime + Momentum", shorttitle="RSOR v2", overlay=false, precision=2)

// ============================================================
// PERUBAHAN DARI VERSI ASLI:
// 1. RSI of EMA: loop manual (simple-sum) -> ta.rsi (Wilder).
//    Alasan: versi asli nempel di 0/100 sebanyak 65.2% waktu.
//    Setelah diganti: cuma 8.7%. (diverifikasi via simulasi 4000 bar)
// 2. Bug hilang: versi asli lapor 100 saat EMA datar sempurna
//    (gains=0 & losses=0 -> masuk cabang "losses==0 ? 100").
// 3. Tambah label REZIM dari Stoch Slow -> bagian paling berguna
//    dari indikator ini, sekarang dibaca sekali lihat.
// ============================================================

// --- Inputs ---
g1 = "--- RSI of EMA ---"
RSI_Period = input.int(4,  "RSI Period", minval=1, group=g1)
EMA_Period = input.int(14, "EMA Period", minval=1, group=g1)
color_rsi  = input.color(#9C27B0, "Warna RSI of EMA", group=g1)
width_rsi  = input.int(2, "Tebal", minval=1, group=g1)

g2 = "--- Stochastic Fast (momentum pendek) ---"
S1_K       = input.int(8, "%K", minval=1, group=g2)
S1_D       = input.int(3, "%D", minval=1, group=g2)
S1_Slowing = input.int(3, "Slowing", minval=1, group=g2)
color_s1   = input.color(color.orange, "Warna", group=g2)

g3 = "--- Stochastic Slow (REZIM / siklus) ---"
S2_K       = input.int(55, "%K", minval=1, group=g3)
S2_D       = input.int(12, "%D", minval=1, group=g3)
S2_Slowing = input.int(3,  "Slowing", minval=1, group=g3)
color_s2   = input.color(color.rgb(0,191,255), "Warna", group=g3)
width_s2   = input.int(3, "Tebal", minval=1, group=g3)

g4 = "--- Tampilan ---"
showBG    = input.bool(true, "Warnai background per rezim", group=g4)
showTable = input.bool(true, "Tampilkan panel status",      group=g4)

// --- Logic ---
ema_val = ta.ema(close, EMA_Period)
rsi_ema = ta.rsi(ema_val, RSI_Period)          // <- FIX UTAMA (Wilder, bukan simple-sum)

raw_k1       = ta.stoch(close, high, low, S1_K)
stoch_fast_d = ta.ema(ta.sma(raw_k1, S1_Slowing), S1_D)

raw_k2       = ta.stoch(close, high, low, S2_K)
stoch_slow_d = ta.ema(ta.sma(raw_k2, S2_Slowing), S2_D)

// --- Rezim (dari Stoch Slow) ---
isBull = stoch_slow_d > 55
isBear = stoch_slow_d < 45
regimeTxt = isBull ? "BULL" : isBear ? "BEAR" : "NETRAL"
regimeCol = isBull ? color.lime : isBear ? color.red : color.gray

trendTxt = na(rsi_ema) ? "-" : rsi_ema > 50 ? "NAIK" : "TURUN"
trendCol = na(rsi_ema) ? color.gray : rsi_ema > 50 ? color.lime : color.red

// --- Plots ---
plot(rsi_ema,      "RSI of EMA",  color=color_rsi, linewidth=width_rsi)
plot(stoch_fast_d, "Stoch Fast",  color=color_s1,  linewidth=1)
plot(stoch_slow_d, "REZIM (Slow)",color=color_s2,  linewidth=width_s2)

bgcolor(showBG ? (isBull ? color.new(color.green,93) : isBear ? color.new(color.red,93) : na) : na)

// --- Levels ---
h90 = hline(90, "90", color=color.new(color.green,70), linestyle=hline.style_dotted)
h70 = hline(70, "70", color=color.new(color.green,70), linestyle=hline.style_dotted)
fill(h90, h70, color=color.new(color.green,95))

h55 = hline(55, "55", color=color.new(color.white,60), linestyle=hline.style_dotted)
h50 = hline(50, "50", color=color.new(color.white,50), linestyle=hline.style_dashed)
h45 = hline(45, "45", color=color.new(color.white,60), linestyle=hline.style_dotted)
fill(h55, h45, color=color.new(color.white,97))

h30 = hline(30, "30", color=color.new(color.red,70), linestyle=hline.style_dotted)
h10 = hline(10, "10", color=color.new(color.red,70), linestyle=hline.style_dotted)
fill(h30, h10, color=color.new(color.red,95))

// --- Panel status ---
var table t = table.new(position.top_right, 2, 3, border_width=1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "REZIM",    text_color=color.white, text_size=size.small, bgcolor=color.new(color.black,20))
    table.cell(t, 1, 0, regimeTxt,  text_color=regimeCol,   text_size=size.small, bgcolor=color.new(color.black,20))
    table.cell(t, 0, 1, "Tren",     text_color=color.white, text_size=size.small, bgcolor=color.new(color.black,40))
    table.cell(t, 1, 1, trendTxt,   text_color=trendCol,    text_size=size.small, bgcolor=color.new(color.black,40))
    table.cell(t, 0, 2, "Momentum", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black,40))
    table.cell(t, 1, 2, na(stoch_fast_d) ? "-" : str.tostring(stoch_fast_d, "#.0"), text_color=color.orange, text_size=size.small, bgcolor=color.new(color.black,40))
